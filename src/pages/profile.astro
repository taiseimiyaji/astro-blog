---
import Header from "../components/Header/Header";
import "../styles/index.scss";
import Footer from "../components/Footer/Footer";
import GitHubCard from "../components/SNS/GitHubCard";
import XCard from "../components/SNS/XCard";
import ZennCard from "../components/SNS/ZennCard";
import { getCollection } from "astro:content";
import { postOrderByCreatedAt } from "../utils/sort";

const blogEntries = await (await getCollection("blog")).filter(
	(entry) => !entry.data.draft,
);
const posts = postOrderByCreatedAt(blogEntries);

declare global {
    interface Window {
        dataLayer: unknown[];
        gtag: (...args: unknown[]) => void;
    }
}
---
<html lang="ja">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta name="description"
          content="技術本駆動系WEBエンジニアの備忘録 気になっている技術をキャッチアップするために記事にしたりしています。あくまで個人的な感想を含んだ備忘録です。">
    <title>このブログの作者について</title>
</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZBD90YGZ4N"></script>
<script>
    window.dataLayer = window.dataLayer || [];

    function gtag(...args: unknown[]) {
        window.dataLayer.push(args);
    }

    gtag('js', new Date());

    gtag('config', 'G-ZBD90YGZ4N');
</script>
<body>
<main>
    <Header></Header>
    <div class="content">
        <h1>このブログの作者について</h1>
        <div style="display: flex; justify-content: center; margin-bottom: 1rem;">
            <img src="/images/icon-bg.png" alt="プロフィールアイコン" width="160" height="160" style="border-radius: 50%; !important; max-width: 160px !important;">
        </div>
        <div style="display: flex; justify-content: center; margin-bottom: 1rem;">
            <h2>Taisei Miyaji</h2>
        </div>
        <p>
            <h3>所属 <a href="https://corp.smaregi.jp/">株式会社スマレジ</a> AI開発基盤チーム 主任</h3>
            エンジニアとしてのキャリアは組み込み系から始まり、現在はWEBエンジニアとして開発業務のリードをしています。<br>
            <br>
            このブログでは業務や趣味の開発を通して得た知見をメモ代わりにまとめています。
        </p>
        <h2>Offerings</h2>

        <ul>
            <li><strong>テスト支援</strong><br>
                開発プロセスの品質向上のために、ユニットテストの導入やテスト自動化の支援を行います。CI/CD環境の構築やテストフレームワークの選定・導入も対応可能です。
            </li>
            <li><strong>開発支援</strong><br>
                生成AIを活用した開発体制の構築やPoC開発をはじめ、技術課題の整理から実装・改善まで、プロジェクトの状況に合わせて支援します。
            </li>
            <li><strong>AIで作成したプロダクトへのコンサルティング</strong><br>
                技術選定やアーキテクチャ設計、開発プロセスの改善など、さまざまな観点から、AIで作成した成果物に対する専門家のレビュー、修正対応を行います。
            </li>
        </ul>
        <h2>ご依頼について</h2>
        <div class="contact-section">
            <p>
                相談内容が固まっていない段階でも大丈夫です。まずは相談フォームから、現在のお悩みやご希望をお聞かせください。内容を確認後、メールでご連絡します。
            </p>
            <a class="contact-button" href="https://forms.gle/omP7TPeSf2VacxSGA" target="_blank" rel="noopener noreferrer">
                相談フォームを開く
                <span aria-hidden="true">→</span>
            </a>
            <p class="contact-alternative">
                フォームを利用できない場合は、
                <a href="mailto:taisei.miyaji4602@gmail.com">メールでお問い合わせください</a>。
            </p>
        </div>
        <div class="card-container" style="margin-top: 2rem; margin-bottom: 2rem;">
            <GitHubCard url={'https://github.com/taiseimiyaji'} />
            <XCard url={'https://x.com/lyricrime'} />
            <ZennCard url={'https://zenn.dev/miyaji4602/'} />
        </div>
    </div>
    <Footer></Footer>
</main>
</body>
</html>

<style>
    .contact-section {
        padding: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 0.75rem;
        background: rgba(255, 255, 255, 0.04);
    }

    .contact-section > p:first-child {
        margin-top: 0;
    }

    .contact-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        min-height: 3rem;
        padding: 0.75rem 1.25rem;
        border-radius: 0.5rem;
        background: rgb(var(--accent));
        color: white;
        font-weight: 700;
        transition: filter 0.2s ease, transform 0.2s ease;
    }

    .contact-button:hover {
        filter: brightness(1.15);
        transform: translateY(-1px);
    }

    .contact-button:focus-visible {
        outline: 3px solid white;
        outline-offset: 3px;
    }

    .contact-alternative {
        margin-bottom: 0;
        font-size: 0.95rem;
    }

    .contact-alternative a {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    @media (max-width: 480px) {
        .contact-button {
            width: 100%;
        }
    }
</style>
